+              "include_directories(${GMOCK_INCLUDEDIR} ${LIBGMOCK_INCLUDE_DIR})\n" \
+              "include(GoogleTest)\n" \
+              "enable_testing()\n",
+              ""
+      s.gsub!(/\nlist\(APPEND testsupport_sources.*?target_link_libraries\(testsupport log string jansson third_party_deps\)\n/m, "\n")
+      s.gsub!(/\nset\(tests\).*\z/m, "\n")
+    end

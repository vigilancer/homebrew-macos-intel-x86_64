#!/bin/sh
set -eu

env_file() {
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "${XDG_CONFIG_HOME}/homebrew/brew.env"
  elif [ -n "${HOMEBREW_XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "${HOMEBREW_XDG_CONFIG_HOME}/homebrew/brew.env"
  else
    printf '%s\n' "${HOME}/.homebrew/brew.env"
  fi
}

file=$(env_file)
if [ ! -f "$file" ]; then
  echo "error: $file is missing" >&2
  exit 1
fi

remote=$(sed -n 's/^[[:space:]]*HOMEBREW_BREW_GIT_REMOTE=//p' "$file" | head -n 1)
if [ -z "$remote" ]; then
  echo "error: HOMEBREW_BREW_GIT_REMOTE is not set in $file" >&2
  exit 1
fi

repo=$(brew --repository)
git -C "$repo" rebase --abort 2>/dev/null || true
git -C "$repo" remote set-url origin "$remote"
git -C "$repo" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"

echo "origin of $repo is $remote"
echo
echo "Run this to fetch the patched Homebrew:"
echo
echo "    brew update"
echo
echo "Then check ORIGIN, HOMEBREW_VERSION and HEAD:"
echo
echo "    brew config"

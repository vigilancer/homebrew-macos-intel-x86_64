#!/bin/sh
set -eu

manage=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
brew=$manage/brew
upstream=https://github.com/Homebrew/brew
patchdir=$manage/patches
patches="0001-unsupported-os.patch 0002-build-from-source.patch 0003-formula-overlay.patch 0004-forbid-casks-no-whining.patch"

latest=$(
  git ls-remote --tags "$upstream" |
    sed -n 's#.*refs/tags/\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$#\1#p' |
    sort -V |
    tail -n 1
)
if [ -z "$latest" ]; then
  echo "no upstream X.Y.Z tag" >&2
  exit 1
fi

if [ ! -d "$brew/.git" ]; then
  mkdir -p "$brew"
  git -C "$brew" init -b master
fi

git -C "$brew" config advice.implicitIdentity false

# Keep the upstream tag under another ref. refs/tags/<latest> is moved onto our commit.
git -C "$brew" fetch --depth 1 "$upstream" \
  "refs/tags/${latest}:refs/upstream-tags/${latest}"
upstream_commit=$(git -C "$brew" rev-parse "refs/upstream-tags/${latest}^{}")
head=$(git -C "$brew" rev-parse --verify HEAD 2>/dev/null || true)
tag_commit=$(git -C "$brew" rev-parse --verify "refs/tags/${latest}^{}" 2>/dev/null || true)

move_tag() {
  git -C "$brew" tag -f -a "$latest" HEAD -m "Move tag ${latest} from ${upstream_commit} onto the unsupported-os patch.

The upstream tag pointed at ${upstream_commit}.
It was moved on purpose and now points at this commit."
}

if [ -n "$head" ] && [ "$head" = "$tag_commit" ] &&
   git -C "$brew" merge-base --is-ancestor "$upstream_commit" "$head"
then
  echo "brew is already ${latest} plus patches"
  exit 0
fi

git -C "$brew" checkout -B master "$upstream_commit"
for name in $patches; do
  git -C "$brew" apply --index "$patchdir/$name"
  git -C "$brew" commit -m "Apply ${name} on ${latest}"
done
move_tag
echo "brew master moved to ${latest} plus patches"

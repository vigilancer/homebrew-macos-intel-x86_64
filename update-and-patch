#!/bin/sh
# Fetch the latest Homebrew tag into .bare, apply patches, move that tag
# onto the patched commit, and replace the brew submodule with the result.
set -eu

manage=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
work=$manage/.work
sub=$manage/brew
bare=$manage/.bare
upstream=https://github.com/Homebrew/brew
patchdir=$manage/patches

export GIT_TERMINAL_PROMPT=0

copy_upstream_tags() {
  git -C "$bare" for-each-ref --format='%(objectname) %(refname)' refs/tags |
    while read -r obj name; do
      tag=${name#refs/tags/}
      git -C "$bare" update-ref "refs/upstream-tags/${tag}" "$obj"
    done
}

# The submodule keeps its own objects. Replacing main and every tag from .bare
# moves only the commits that differ; the shared brew history stays put.
replace_submodule() {
  if [ ! -e "$sub/.git" ]; then
    echo "error: $sub is not the evil-brew submodule" >&2
    exit 1
  fi
  git -C "$sub" fetch --force --prune --prune-tags "$bare" \
    '+refs/heads/main:refs/patch-tmp/main' \
    '+refs/tags/*:refs/tags/*'
  git -C "$sub" checkout -f -B main refs/patch-tmp/main
  git -C "$sub" clean -fd
  git -C "$sub" update-ref -d refs/patch-tmp/main
  for branch in $(git -C "$sub" for-each-ref --format='%(refname:short)' refs/heads); do
    [ "$branch" = main ] && continue
    git -C "$sub" branch -D "$branch"
  done
}

if [ -d "$bare" ]; then
  if ! git -C "$bare" fetch "$upstream" '+refs/tags/*:refs/upstream-tags/*'; then
    echo "warning: could not fetch ${upstream}; continuing with tags already in .bare" >&2
  fi
else
  echo "cloning ${upstream} into .bare"
  if ! git clone --bare "$upstream" "$bare"; then
    echo "error: could not clone ${upstream} into .bare" >&2
    exit 1
  fi
  copy_upstream_tags
fi

latest=$(
  git -C "$bare" for-each-ref --format='%(refname:strip=2)' refs/upstream-tags |
    sed -n 's/^\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$/\1/p' |
    sort -V |
    tail -n 1
)
if [ -z "$latest" ]; then
  echo "error: no upstream X.Y.Z tag in .bare" >&2
  exit 1
fi

upstream_commit=$(git -C "$bare" rev-parse "refs/upstream-tags/${latest}^{}")
# Same identity and timestamp on every run, so deleting .bare and running
# ./update-and-patch again recreates these commits instead of rewriting main.
upstream_date=$(git -C "$bare" log -1 --format=%cd --date=raw "$upstream_commit")
git -C "$bare" config advice.implicitIdentity false

git_as_patch() {
  GIT_AUTHOR_NAME=none \
  GIT_AUTHOR_EMAIL=none \
  GIT_COMMITTER_NAME=none \
  GIT_COMMITTER_EMAIL=none \
  GIT_AUTHOR_DATE="$upstream_date" \
  GIT_COMMITTER_DATE="$upstream_date" \
    git -C "$work" "$@"
}

is_worktree() {
  [ -e "$work/.git" ] || return 1
  common=$(git -C "$work" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  bare_abs=$(CDPATH= cd -- "$bare" && pwd -P)
  [ "$common" = "$bare_abs" ]
}

if ! is_worktree; then
  backup=
  if [ -e "$work" ]; then
    backup=$(mktemp -d "${TMPDIR:-/tmp}/brew-self-update.XXXXXX")
    mv "$work" "$backup/work"
  fi
  if ! git -C "$bare" worktree add -B main "$work" "$upstream_commit"; then
    if [ -n "$backup" ]; then
      mv "$backup/work" "$work"
      rm -rf "$backup"
    fi
    echo "error: could not create .work worktree" >&2
    exit 1
  fi
  if [ -n "$backup" ]; then
    rm -rf "$backup"
  fi
fi

move_tag() {
  git_as_patch tag -f -a "$latest" HEAD -m "Move tag ${latest} from ${upstream_commit} onto the unsupported-os patch.

The upstream tag pointed at ${upstream_commit}.
It was moved on purpose and now points at this commit."
}

# Homebrew tracks origin/main. The tag fetch does not create that branch.
on_main() {
  branch=$(git -C "$work" symbolic-ref --short HEAD 2>/dev/null || true)
  if [ -n "$branch" ] && [ "$branch" != main ]; then
    git -C "$work" branch -M main
  fi
  if git -C "$work" show-ref --verify --quiet refs/heads/master; then
    git -C "$work" branch -D master
  fi
}

head=$(git -C "$work" rev-parse --verify HEAD 2>/dev/null || true)
tag_commit=$(git -C "$work" rev-parse --verify "refs/tags/${latest}^{}" 2>/dev/null || true)
head_date=$(git -C "$work" log -1 --format=%cd --date=raw "$head" 2>/dev/null || true)
if [ -z "$(git -C "$work" status --porcelain)" ] &&
   [ -n "$head" ] && [ "$head" != "$upstream_commit" ] && [ "$head" = "$tag_commit" ] &&
   [ "$head_date" = "$upstream_date" ] &&
   git -C "$work" merge-base --is-ancestor "$upstream_commit" "$head"
then
  on_main
  replace_submodule
  echo "brew is already ${latest} plus patches"
  exit 0
fi

if [ -n "$(git -C "$work" status --porcelain)" ] || [ "$head" != "$upstream_commit" ]; then
  git -C "$work" checkout -B main
  git -C "$work" reset --hard "$upstream_commit"
  git -C "$work" clean -fd
fi

set -- "$patchdir"/*.patch
if [ ! -f "$1" ]; then
  echo "no patches in $patchdir" >&2
  exit 1
fi
patches=$(
  for path in "$@"; do
    basename "$path"
  done | sort -V
)
oldifs=$IFS
IFS='
'
for name in $patches; do
  git -C "$work" apply --index "$patchdir/$name"
  git_as_patch commit -m "evil: Apply ${name} on ${latest}"
done
IFS=$oldifs
move_tag
on_main
replace_submodule
echo "brew submodule replaced with ${latest} plus patches"
